# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env

# Jupyter
.ipynb_checkpoints/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Chunks, vectors and verdicts are generated during the workshop — not shipped
data/03_chunks/*
!data/03_chunks/.gitkeep
data/04_vectors/*
!data/04_vectors/.gitkeep
data/07_verdicts/*
!data/07_verdicts/.gitkeep

# Diagram sources; only the rendered PNG is shipped
notebooks/assets/*.svg
